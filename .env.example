# Gymnasium Customer Retention Risk Inference API Configuration
# Copy this file to .env and configure as needed. DO NOT commit .env to version control!

# Server host and port
HOST=127.0.0.1
PORT=8000

# Path to the trained 8-feature Random Forest joblib model (v3 is default; set to models/random_forest_8fitur.joblib for v1, or v2 for rule-based)
MODEL_PATH=models/random_forest_8fitur_v3.joblib

# Application logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
