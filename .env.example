# Gymnasium Customer Retention Risk Inference API Configuration
# Copy this file to .env and configure as needed. DO NOT commit .env to version control!

# Server host and port
HOST=127.0.0.1
PORT=8000

# Path to the trained 8-feature Random Forest joblib model
MODEL_PATH=models/random_forest_8fitur.joblib

# Application logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
